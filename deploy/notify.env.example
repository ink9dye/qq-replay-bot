# 推送优先级：填了 PUSHPLUS_TOKEN 就走微信推送，否则回退到 QQ 邮箱 SMTP。
PUSHPLUS_TOKEN=

# 以下仅在不用 PushPlus 时生效。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASS=16位授权码
SMTP_TO=你的QQ邮箱@qq.com

# 资源持续异常才报警；独立资源定时器每 30 秒采样。
HEALTH_MIN_AVAILABLE_MB=150
HEALTH_MAX_DISK_PERCENT=80
HEALTH_RESOURCE_HOLD_SECONDS=120
HEALTH_REPEAT_SECONDS=1800
