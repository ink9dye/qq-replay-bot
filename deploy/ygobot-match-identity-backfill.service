[Unit]
Description=Backfill match identity index for card reports
After=network.target

[Service]
Type=oneshot
User=ygo
Group=ygo
WorkingDirectory=/opt/ygobot
Environment=TZ=Asia/Shanghai
ExecStart=/usr/bin/python3 /opt/ygobot/tools/backfill_match_identity.py --root /opt/ygobot
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
