[Unit]
Description=YGO eligible views snapshot (default 100:all)
After=network.target ygo-web.service
Wants=ygo-web.service

[Service]
Type=oneshot
User=ygo
Group=ygo
WorkingDirectory=/opt/ygobot
Environment=TZ=Asia/Shanghai
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/ygobot/tools/precompute_eligible.py
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=500M
TimeoutStartSec=600
